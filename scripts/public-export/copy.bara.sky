# One-way export of the product tree to the public repository. run.ts renders
# __ORIGIN_URL__, __STAGING_URL__ and __AUTHOR__ into a scratch copy before every run.

PUBLIC_AUTHOR = "__AUTHOR__"

# Fail closed: a new top-level folder or root file stays private until it is
# named here.
PRODUCT_FILES = glob(
    include = [
        "src/**",
        "container/**",
        "setup/**",
        "scripts/**",
        "dashboard/**",
        "assets/**",
        "bin/**",
        "config-examples/**",
        "launchd/**",
        "patches/**",
        "templates/**",
        "tests/**",
        "repo-tokens/**",
        "tone-profiles/**",
        ".claude/skills/**",
        "public-overlay/**",
        "docs/*.md",
        "docs/dependency-changes/**",
        ".husky/**",
        "LICENSE",
        "CHANGELOG.md",
        "CODE_OF_CONDUCT.md",
        "CONTRIBUTORS.md",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig*.json",
        "vitest*.ts",
        "eslint.config.js",
        "knip.json",
        ".jscpd.json",
        ".prettierrc",
        ".prettierignore",
        ".gitignore",
        ".nvmrc",
        ".pnpmfile.cjs",
        ".env.example",
        "setup.sh",
        "nanoclaw.sh",
        "uninstall.sh",
        "migrate-v2*.sh",
        "versions.json",
        "coverage-risk-baseline.json",
    ],
    exclude = [
        "docs/specs/**",
        "docs/retros/**",
        "docs/review-notes/**",
        "docs/review-notes.md",
        "docs/handoffs/**",
        "docs/CUTOVER_RUNBOOK.md",
        "docs/MIGRATION_FROM_V1.md",
        "docs/PHASE_*.md",
        "docs/SPIKE_NOTES.md",
        "docs/V2_BACKLOG.md",
        "docs/profound.md",
        "docs/project-scope.md",
        "docs/codex-parity-test-plan.md",
        "docs/codex-hook-support.md",
        "docs/always-on-directive-*.md",
        # Tests whose subject is this repository's own CI and review governance
        # (.github/, review notes, design specs, the upstream ratchet), none of
        # which is exported: in the public tree they would test a missing file.
        "scripts/check-risk-coverage.test.ts",
        "scripts/codex-review.test.ts",
        "scripts/gate-audit.test.ts",
        "scripts/host-ci-declaration.test.ts",
        "scripts/hygiene/policy-paths.test.ts",
        "scripts/labeler-config-tripwire.test.ts",
        "scripts/public-export/allowlist.test.ts",
        "scripts/review-notes.test.ts",
        "scripts/risk-globs.test.ts",
        "scripts/risk-scope.test.ts",
        "scripts/workflow-label-descriptions.test.ts",
        "src/memory-migration-contract.test.ts",
        "src/upstream-ratchet.test.ts",
        # This repository's boundary gate and push policy (see PUBLIC_HOOKS below), and the tests that run them.
        ".husky/pre-push",
        ".husky/commit-msg",
        "scripts/boundary-hooks.test.ts",
        "scripts/pre-push.test.ts",
        "scripts/setup-typecheck-gates.test.ts",
        # This install's fleet MCP defaults; public-overlay/ ships an empty set in their place.
        "src/fleet-mcp-default-servers.ts",
        "src/fleet-mcp-default-servers.test.ts",
        # This host's own systemd units; setup/service.ts writes an install's units.
        "scripts/nanoclaw-v2.service",
        "scripts/nanoclaw-codex-sync.service",
        "container/skills/smoke-test/scripts/testdata/controller-replay-corpus.ndjson",
        "container/skills/smoke-test/scripts/smoke-controller-shadow-report.test.sh",
        "data/**",
        ".public-boundary-*.json",
        "PROGRESS.md",
        ".github/**",
        ".agents/**",
        ".design-artifact-loop/**",
        "groups/**",
        "**/groups/**",
        ".context/**",
        "**/.context/**",
    ],
)

def export_workflow(name, mode, transformations):
    core.workflow(
        name = name,
        origin = git.origin(url = "__ORIGIN_URL__", ref = "main"),
        destination = git.destination(url = "__STAGING_URL__", push = "main", fetch = "main"),
        origin_files = PRODUCT_FILES,
        destination_files = glob(["**"]),
        authoring = authoring.overwrite(PUBLIC_AUTHOR),
        mode = mode,
        transformations = transformations,
    )

# The root README.md and CLAUDE.md describe this private install; the public ones live in public-overlay/.
PUBLIC_OVERLAY = core.move("public-overlay", "")

# This install's policy that a public clone must not inherit. run.ts passes --ignore-noop, so a replace whose
# `before` no longer matches would export silently: allowlist.test.ts asserts each one matches its file once.
#
# The prebuild gate refuses a dirty tree or a HEAD other than origin/main, which is every public install after
# a channel skill copies its adapter in. A public build is tsc plus the dashboard bundle.
PUBLIC_BUILD = core.replace(
    before = """    "prebuild": "tsx scripts/check-build-clean.ts",
""",
    after = "",
    multiline = True,
    paths = glob(["package.json"]),
)

# Setup reports install events to upstream's PostHog project unless opted out; the public product sends none
# unless the operator opts in.
PUBLIC_DIAGNOSTICS = [
    core.replace(
        before = """[ "$${NANOCLAW_NO_DIAGNOSTICS:-}" = "1" ] && return 0""",
        after = """[ "$${NANOCLAW_DIAGNOSTICS:-}" = "1" ] || return 0""",
        paths = glob(["setup/lib/diagnostics.sh"]),
    ),
    core.replace(
        before = "if (process.env.NANOCLAW_NO_DIAGNOSTICS === '1') return;",
        after = "if (process.env.NANOCLAW_DIAGNOSTICS !== '1') return;",
        paths = glob(["setup/lib/diagnostics.ts"]),
    ),
    core.replace(
        before = "Honors NANOCLAW_NO_DIAGNOSTICS=1.",
        after = "Sends nothing unless NANOCLAW_DIAGNOSTICS=1.",
        paths = glob(["setup/lib/diagnostics.sh", "setup/lib/diagnostics.ts"]),
    ),
]

# The boundary scan protects this private repository's identifiers and the push refusal guards its main. Neither
# means anything in a public clone: there the scan harvests the installer's own registry (their name, `local`, `cli`)
# and refuses their every commit. The public pre-push and commit-msg hooks are excluded above, and the public
# pre-commit keeps only its formatting gate. The `check:public-boundary` script stays runnable by hand in a fresh
# clone, which has no registry or identifier inventory: it tolerates a source whose file does not exist, and still
# refuses one that exists but cannot be read.
PUBLIC_HOOKS = [
    core.replace(
        before = """
# Run from the main checkout so tsx resolves there, but scan THIS tree.
#
# `--root` is not optional. Without it the script defaults to process.cwd(),
# which the `cd` has just made the main checkout — so a commit from a linked
# worktree scanned main's index, entirely different content, and printed
# "passed" about work it never saw. Every commit made from an agent worktree
# was ungated until 2026-08-26. The registry itself still resolves through the
# main checkout via findMainCheckoutRoot's fallback.
#
# tsx, not `pnpm run`: pnpm exits 0 when a write to its own stdout fails with
# EPIPE, so `git commit 2>&1 | head` turned a failed scan into a created commit.
worktree_root=$$(git rev-parse --show-toplevel)
(cd "$$repo_root" && "$$repo_root/node_modules/.bin/tsx" "$$repo_root/scripts/check-public-boundary.ts" --root "$$worktree_root" --staged)
""",
        after = "",
        multiline = True,
        paths = glob([".husky/pre-commit"]),
    ),
    core.replace(
        before = "\"check:public-boundary\": \"tsx scripts/check-public-boundary.ts\"",
        after = "\"check:public-boundary\": \"tsx scripts/check-public-boundary.ts --allow-absent-sources\"",
        paths = glob(["package.json"]),
    ),
]

PUBLIC_TRANSFORMS = [PUBLIC_OVERLAY, PUBLIC_BUILD] + PUBLIC_DIAGNOSTICS + PUBLIC_HOOKS

export_workflow(
    name = "export",
    mode = "ITERATIVE",
    transformations = PUBLIC_TRANSFORMS + [
        metadata.replace_message("${COPYBARA_CURRENT_MESSAGE_TITLE}"),
        metadata.scrubber("^Merge (pull request #[0-9]+ from|remote-tracking branch|branch) .*$", replacement = "Merge changes"),
        metadata.scrubber(" *\\(#[0-9]+\\)$"),
    ],
)

export_workflow(
    name = "export_squash",
    mode = "SQUASH",
    transformations = PUBLIC_TRANSFORMS + [
        metadata.replace_message("Snapshot of the product tree"),
    ],
)
