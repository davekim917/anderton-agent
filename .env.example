# Trunk ships no required env vars of its own. Skills that need one append
# their block here — see the relevant SKILL.md.

# Browser takeover (docs/browser-takeover.md): the HTTPS hostname a tunnel routes to the takeover proxy. Unset = off.
# BROWSER_TAKEOVER_ORIGIN=https://browser.example.com
# BROWSER_TAKEOVER_PORT=3001

# Live app preview (docs/preview.md): the DNS suffix whose wildcard (*.<suffix>) a tunnel routes to the preview proxy.
# Unset = off.
# PREVIEW_ORIGIN_SUFFIX=preview.example.com
# PREVIEW_PORT=3002

# pr-review-loop (docs/review-policy.md): repos whose review receipts carry the neutral reviewer label, as
# comma-separated owner/repo. The host forwards it to every agent container at spawn; a change needs a host restart.
# CODEX_REVIEW_NEUTRAL_REVIEWER_REPOS=ExampleOrg/web,ExampleOrg/data

# Host-ops alerts (health sentinel, unit failures, OneCLI watchdogs, boot checks): the messaging_groups.id of a Slack
# or Discord channel to post them to. Read per alert, no restart. Unset, or a failed post, = the owner's newest Slack DM.
# OPERATOR_ALERT_CHANNEL=mg-example-ops-alerts
